{
  "dock": 1,
  "key": "zulu",
  "name": "Zulu Clock",
  "bundle_id": "org.ffw.zulu-clock",
  "icon": "icons/zulu-clock.svg",
  "icon_px": 824,

  "port": 8769,
  "page": "http://localhost:{port}/zulu-clock.html",
  "tab_match": ":{port}/zulu-clock",

  "start": ["python3", "{repo}/server.py", "{port}", "{repo}"],
  "restart": null,
  "ours": { "command": "server.py {port}" },
  "health": "/status",
  "log": "~/Library/Logs/zulu-clock.log",

  "stale_if_changed": ["server.py"],
  "on_stale": "restart",
  "restart_loses": "the in-memory feed cache, which refills on the next calls",
  "reload_when": "head",

  "env": { "MISSIONS_CALL": null },
  "link_scheme": null
}
